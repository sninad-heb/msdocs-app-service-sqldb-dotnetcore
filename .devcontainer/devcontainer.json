// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "C# (.NET) and PostgreSQL",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

	"features": {
		"ghcr.io/azure/azure-dev/azd:latest": {},
		"ghcr.io/devcontainers/features/sshd:1": {},
		"ghcr.io/devcontainers/features/azure-cli:1": {}
	},

	// Reduce peak build memory so `dotnet publish` (e.g. during `azd up`) isn't
	// OOM-killed on smaller Codespace machines: use workstation GC and avoid
	// leaving persistent MSBuild/Roslyn build-server processes resident.
	"remoteEnv": {
		"DOTNET_gcServer": "0",
		"MSBUILDDISABLENODEREUSE": "1",
		"DOTNET_CLI_USE_MSBUILD_SERVER": "0"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot"
			]
		}
	},

	"forwardPorts": [5093, 7291],
	"postCreateCommand": "dotnet tool install --global dotnet-ef --version 10.* && dotnet restore"

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
